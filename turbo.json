{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "CHAT_BACKEND",
        "INKEEP_*",
        "INTAKE_*",
        "PARLANT_*",
        "ANTHROPIC_API_KEY",
        "VOYAGE_API_KEY",
        "TAVILY_API_KEY",
        "SEARCH_*",
        "API_PROXY_TARGET",
        "VITE_*"
      ]
    }
  }
}
