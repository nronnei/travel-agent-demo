# Copy to .env with ./scripts/init-env.sh, which also generates the secrets below.
# Read by docker compose, the Nest API (npm run dev) and apps/agents (inkeep push).

# ---- LLM provider ----
ANTHROPIC_API_KEY=

# ---- Inkeep wiring (what the Nest API and `inkeep push` talk to) ----
# 127.0.0.1 rather than localhost: Docker may publish the port on IPv4 only.
INKEEP_AGENTS_API_URL=http://127.0.0.1:3002
INKEEP_TENANT_ID=default
INKEEP_PROJECT_ID=travel-agent
INKEEP_AGENT_ID=travel-agent
# Where Inkeep's context fetcher reaches the Nest API for the guest's intake, as
# seen from inside the Inkeep container. Read by `inkeep push`, so push again after
# changing it. The default suits `npm run dev` (API on the host); when the API runs
# in compose too (`docker compose up`), use http://api:3000.
INTAKE_API_URL=http://host.docker.internal:3000

# ---- Inkeep visual builder login (http://localhost:3001) ----
INKEEP_AGENTS_MANAGE_UI_USERNAME=admin@example.com
INKEEP_AGENTS_MANAGE_UI_PASSWORD=<generated>

# ---- Inkeep secrets (generated) ----
# Bearer token for the manage API; used by `inkeep push`.
INKEEP_AGENTS_MANAGE_API_BYPASS_SECRET=<generated>
# Bearer token for the run API; used server-side by the Nest chat proxy. Never send to the browser.
INKEEP_AGENTS_RUN_API_BYPASS_SECRET=<generated>
INKEEP_AGENTS_JWT_SIGNING_SECRET=<generated>
BETTER_AUTH_SECRET=<generated>
SPICEDB_PRESHARED_KEY=<generated>
INKEEP_AGENTS_TEMP_JWT_PRIVATE_KEY=<generated>
INKEEP_AGENTS_TEMP_JWT_PUBLIC_KEY=<generated>
# Shared token Inkeep's context fetcher sends to /api/intake/:id/context.
INTAKE_API_TOKEN=<generated>
