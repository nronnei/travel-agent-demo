{
  "name": "@travel-agent/langgraph",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The travel agent built on LangGraph.js, for comparison with the Inkeep and Parlant agents",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env --import ./src/instrumentation.ts src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@fastify/otel": "^1.0.2",
    "@langchain/anthropic": "^1.6.6",
    "@langchain/core": "^1.5.0",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint": "^1.2.3",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.4",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@traceloop/instrumentation-anthropic": "^0.27.0",
    "@travel-agent/shared": "*",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "~4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@electric-sql/pglite-socket": "^0.0.22",
    "@langchain/langgraph-sdk": "^1.17.0",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/pg": "~8.15.6",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.15",
    "vitest": "^4.1.2"
  }
}
