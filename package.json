{
  "name": "travel-agent",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:build": "./scripts/docker-build.sh",
    "deploy": "./scripts/deploy.sh",
    "k8s:dev": "tilt up"
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "prettier": "^3.4.2",
    "turbo": "^2.11.10",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "@inkeep/agents-sdk": {
      "zod": "~4.5.4"
    },
    "@inkeep/agents-cli": {
      "zod": "~4.5.4"
    },
    "react-dom": "^19.3.1"
  }
}
