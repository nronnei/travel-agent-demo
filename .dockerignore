**/node_modules
**/dist
**/coverage
**/.turbo
**/*.tsbuildinfo
**/*.log
# Python virtualenvs and caches (apps/parlant builds from its own context).
# Kept out of the root context, and so out of Tilt's file watches for the Node
# images: apps/parlant/.venv alone is ~650 MB and 3,400 directories.
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
# Env files and local secrets never go in an image (none of the Dockerfiles
# read them; containers get env from Kubernetes Secrets).
**/.env
**/.env.*
**/*-secret.yaml
# Claude Code state, including other sessions' full worktree checkouts.
.claude
.git
deploy
Tiltfile
docker-compose.yml
# Local checkpoint databases (apps/langgraph).
**/*.db
